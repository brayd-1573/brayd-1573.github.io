---
import Base from '../../layouts/Base.astro';
import RundownNote from '../../components/RundownNote.astro';
import { getIssues } from '../../lib/data';
import { pad, plain, ymd } from '../../lib/md';
import '../../styles/rundown.css';
import { site } from '../../data/profile';

const issues = await getIssues();
const [latest, ...archive] = issues;
---

<Base
  title={site.rundown}
  description="A weekly briefing on LLM inference and AI systems: notable vLLM merges, open issues to contribute to, industry and hardware news, papers, talks, and the job market."
>
  <div class="rd">
    <header class="rd-mast">
      <div class="wrap">
        <p class="label" data-decode>[04] {site.rundown}</p>
        <h1 class="rd-headline" data-reveal>The week in LLM inference, in one page.</h1>
        <p class="lede" data-reveal style="--d:120ms">
          Notable vLLM merges, open issues I could contribute to, industry and hardware news, papers, talks, and the job
          market, in one page every Sunday.
        </p>
        <RundownNote />
      </div>
    </header>

    <div class="wrap">
      {
        !latest ? (
          <p class="empty label">The first issue lands Sunday.</p>
        ) : (
          <>
            <a class="feature" href={`/rundown/${latest.id}/`} data-reveal>
              <div class="feature-top">
                <span class="chip on live">
                  <span class="dot" />
                  Latest · Issue {pad(latest.data.issue, 3)}
                </span>
                <span class="label">
                  {ymd(latest.data.window.from)} – {ymd(latest.data.window.to, true)}
                </span>
              </div>
              <h2>{latest.data.headline}</h2>
              <p>{plain(latest.data.tldr, 340)}</p>
              <div class="feature-stats">
                {latest.data.stats.map((s) => (
                  <div>
                    <span class="v">{s.value}</span>
                    <span class="label">{s.label}</span>
                  </div>
                ))}
              </div>
              <span class="label go">
                Read issue {latest.data.issue} <span class="acc">→</span>
              </span>
            </a>

            {archive.length > 0 && (
              <section class="archive">
                <p class="label">Archive</p>
                <ol>
                  {archive.map((it) => (
                    <li>
                      <a href={`/rundown/${it.id}/`}>
                        <span class="n">#{pad(it.data.issue, 3)}</span>
                        <span class="d label">{ymd(it.id, true)}</span>
                        <span class="h">{it.data.headline}</span>
                        <span class="acc arr">→</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </>
        )
      }
      <div class="rd-foot">
        <span class="label">New issue every Sunday · <a href="/rundown/feed.xml">RSS</a></span>
      </div>
    </div>
  </div>
</Base>

<style>
  .lede {
    margin-top: 20px;
    max-width: 62ch;
    font-size: 19px;
    color: var(--fg-muted);
  }
  .empty {
    padding: 64px 0;
  }
  .feature {
    display: block;
    margin-top: 48px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, var(--accent-soft), transparent 45%),
      var(--bg-elev);
    text-decoration: none !important;
    transition: border-color 200ms ease;
  }
  .feature:hover {
    border-color: var(--accent-line);
  }
  .feature-top {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    justify-content: space-between;
    align-items: center;
  }
  .feature h2 {
    margin-top: 28px;
    font-size: clamp(26px, 3.6vw, 44px);
    letter-spacing: -0.035em;
    max-width: 26ch;
  }
  .feature p {
    margin-top: 16px;
    max-width: 72ch;
    color: var(--fg-muted);
  }
  .feature-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .feature-stats > div {
    display: grid;
    gap: 4px;
  }
  .feature-stats .v {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .go {
    display: inline-block;
    margin-top: 28px;
    color: var(--fg);
  }
  .archive {
    margin-top: 64px;
  }
  .archive ol {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .archive a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 6px 20px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none !important;
  }
  @media (min-width: 760px) {
    .archive a {
      grid-template-columns: 72px 140px 1fr auto;
    }
  }
  @media (max-width: 759px) {
    .archive .d {
      grid-column: 2 / 4;
      grid-row: 1;
    }
    .archive .h {
      grid-column: 1 / -1;
    }
    .archive .arr {
      display: none;
    }
  }
  .archive .n {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 14px;
  }
  .archive .h {
    font-size: 17px;
    font-weight: 500;
  }
  .archive a:hover .h {
    color: var(--accent);
  }
</style>
