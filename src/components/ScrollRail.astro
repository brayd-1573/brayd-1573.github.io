---
// Left-margin scroll rail, themed as speculative decoding. The column of tokens represents the
// whole page: tokens above your scroll position are "accepted" by the target model, the next K
// are the draft model's guesses, and a few positions show a "resampled" correction token.
// Purely decorative progress indicator; updates only on scroll/resize (no animation loop).
// Wide screens: centered in the empty left gutter. Narrow screens: a 2px progress line.
const N = 56; // tokens in the column
const K = 4; // draft length
---

<div class="rail" aria-hidden="true" data-n={N} data-k={K}>
  <div class="rail-col">
    {Array.from({ length: N }, () => <i></i>)}
  </div>
  <div class="rail-foot label">
    <span class="acc" data-r="pct">0%</span>
    <span>k={K}</span>
  </div>
</div>
<div class="rail-mobile" aria-hidden="true"><b></b></div>

<style>
  /* Empty space left of the content column = (viewport - maxw)/2 + the wrap's own padding.
     The rail (40px wide) is centered in it. */
  .rail {
    --space: calc((100vw - var(--maxw)) / 2 + var(--gutter));
    position: fixed;
    left: calc(var(--space) / 2 - 20px);
    top: 104px;
    bottom: 40px;
    z-index: 20;
    width: 40px;
    display: none;
    pointer-events: none;
  }
  @media (min-width: 1360px) {
    .rail {
      display: block;
    }
  }
  .rail-col {
    position: absolute;
    left: 16px;
    top: 0;
    bottom: 34px;
    width: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .rail-col i {
    flex: 1;
    min-height: 2px;
    border: 1px solid var(--line-strong);
    transition:
      background-color 220ms ease,
      border-color 220ms ease;
  }
  /* accepted by the target model */
  .rail-col i.a {
    background: color-mix(in srgb, var(--accent) 55%, var(--bg));
    border-color: transparent;
  }
  /* resampled correction (draft token rejected, target's token kept) */
  .rail-col i.a.x {
    background: var(--fg-muted);
  }
  /* current position */
  .rail-col i.c {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 10px var(--accent-line);
  }
  /* draft tokens ahead of the cursor */
  .rail-col i.d {
    border-color: var(--accent-line);
    border-style: dashed;
  }
  .rail-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    justify-items: center;
    font-size: 9.5px;
    line-height: 1.4;
  }

  .rail-mobile {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .rail-mobile b {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @media (min-width: 1360px) {
    .rail-mobile {
      display: none;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('.rail');
  if (rail) {
    const N = Number(rail.dataset.n);
    const K = Number(rail.dataset.k);
    const cells = [...rail.querySelectorAll<HTMLElement>('.rail-col i')];
    const pct = rail.querySelector<HTMLElement>('[data-r="pct"]')!;
    const bar = document.querySelector<HTMLElement>('.rail-mobile b');
    // Deterministic "rejection" positions (~1 in 7), so the column looks the same every visit.
    for (let i = 0, s = 3; i < N; i++) {
      s = (s * 1103515245 + 12345) & 0x7fffffff;
      if (i > 2 && s % 7 === 0) cells[i].classList.add('x');
    }

    let maxScroll = 1;
    let lastCur = -1;
    function update() {
      const p = Math.min(1, Math.max(0, window.scrollY / maxScroll));
      if (bar) bar.style.transform = `scaleX(${p})`;
      pct.textContent = `${Math.round(p * 100)}%`;
      const cur = Math.min(N - 1, Math.floor(p * (N - 1) + 0.0001));
      if (cur === lastCur) return;
      lastCur = cur;
      cells.forEach((c, i) => {
        c.classList.toggle('a', i < cur);
        c.classList.toggle('c', i === cur);
        c.classList.toggle('d', i > cur && i <= cur + K);
      });
    }
    function measure() {
      maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      update();
    }

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', measure);
    window.addEventListener('load', measure);
    // Re-measure only when the page height really changes (fonts/images loading).
    let lastH = 0;
    new ResizeObserver(() => {
      const h = document.documentElement.scrollHeight;
      if (h !== lastH) {
        lastH = h;
        measure();
      }
    }).observe(document.body);
    measure();
  }
</script>
